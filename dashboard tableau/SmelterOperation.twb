          <manual-sort column='[federated.1wo7vgu06mgblh1gax2tj1u49237].[:Measure Names]' direction='ASC'>
            <dictionary>
              <bucket>&quot;[federated.1wo7vgu06mgblh1gax2tj1u49237].[sum:concentrate_feed_dmt:qk]&quot;</bucket>
