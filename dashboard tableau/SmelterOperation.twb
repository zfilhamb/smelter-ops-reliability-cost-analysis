  <worksheets>
    <worksheet name='Cost Variance by Cost Center (USD)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Cost Variance by Cost Center (USD)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_operations+' name='federated.1wo7vgu06mgblh1gax2tj1u49237' />
          </datasources>
          <datasource-dependencies datasource='federated.1wo7vgu06mgblh1gax2tj1u49237'>
            <column caption='Over/Under' datatype='string' name='[Calculation_0327158913200128]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1161136756518925] &gt;= 0 THEN &quot;Over Budget&quot; ELSE &quot;Under Budget&quot; END' />
            </column>
            <column caption='Cost Variance USD' datatype='real' name='[Calculation_1161136756518925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_usd]) - SUM([budget_usd])' />
            </column>
            <column caption='Actual Usd' datatype='real' name='[actual_usd]' role='measure' type='quantitative' />
            <column caption='Budget Usd' datatype='real' name='[budget_usd]' role='measure' type='quantitative' />
            <column caption='Cost Center' datatype='string' name='[cost_center]' role='dimension' type='nominal' />
            <column caption='Cost Element' datatype='string' name='[cost_element]' role='dimension' type='nominal' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Month Key' datatype='date' name='[month_key]' role='dimension' type='ordinal' />
            <column-instance column='[cost_center]' derivation='None' name='[none:cost_center:nk]' pivot='key' type='nominal' />
            <column-instance column='[operating_status]' derivation='None' name='[none:operating_status:nk]' pivot='key' type='nominal' />
            <column caption='Operating Status' datatype='string' name='[operating_status]' role='dimension' type='nominal' />
            <column-instance column='[date]' derivation='Month-Trunc' name='[tmn:date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0327158913200128]' derivation='User' name='[usr:Calculation_0327158913200128:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1161136756518925]' derivation='User' name='[usr:Calculation_1161136756518925:qk]' pivot='key' type='quantitative' />
            <column-instance column='[month_key]' derivation='Year' name='[yr:month_key:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1wo7vgu06mgblh1gax2tj1u49237].[Action (Cost Element,YEAR(Month Key))]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action3_E055DC4D337745A8A08ED563E259BC5A]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[cost_element]' />
              <groupfilter function='level-members' level='[yr:month_key:ok]' />
            </groupfilter>
          </filter>
          <computed-sort column='[federated.1wo7vgu06mgblh1gax2tj1u49237].[none:cost_center:nk]' direction='DESC' using='[federated.1wo7vgu06mgblh1gax2tj1u49237].[usr:Calculation_1161136756518925:qk]' />
          <slices>
            <column>[federated.1wo7vgu06mgblh1gax2tj1u49237].[none:operating_status:nk]</column>
            <column>[federated.1wo7vgu06mgblh1gax2tj1u49237].[tmn:date:qk]</column>
            <column>[federated.1wo7vgu06mgblh1gax2tj1u49237].[Action (Cost Element,YEAR(Month Key))]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <color column='[federated.1wo7vgu06mgblh1gax2tj1u49237].[usr:Calculation_0327158913200128:nk]' />
              <text column='[federated.1wo7vgu06mgblh1gax2tj1u49237].[usr:Calculation_1161136756518925:qk]' />
