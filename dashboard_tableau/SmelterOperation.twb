    <worksheet name='Equipment Reliability: MTBF vs MTTR'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Equipment Reliability: MTBF vs MTTR</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_operations+' name='federated.1wo7vgu06mgblh1gax2tj1u49237' />
          </datasources>
          <datasource-dependencies datasource='federated.1wo7vgu06mgblh1gax2tj1u49237'>
            <column caption='Is Unplanned Impactful' datatype='integer' name='[Calculation_0892031753342982]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_planned] = &quot;N&quot; AND [impact_type] &lt;&gt; &quot;No Impact&quot; THEN 1 ELSE 0 END' />
            </column>
            <column caption='MTTR (hr)  — LOD per equipment' datatype='real' name='[Calculation_0892031753658376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [equipment] : AVG(IF [Calculation_0892031753342982]=1 THEN [duration_hr] END) }' />
            </column>
            <column caption='DownHours' datatype='real' name='[Calculation_0892031753867273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [equipment] : SUM(IF [Calculation_0892031753342982]=1 THEN [duration_hr] END) }' />
            </column>
            <column caption='Failures' datatype='integer' name='[Calculation_0892031754084362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [equipment] : SUM([Calculation_0892031753342982]) }' />
            </column>
            <column caption='MTBF (hr)  — LOD per equipment' datatype='real' name='[Calculation_0892031754301451]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(duration_hr - [Calculation_0892031753867273]) / [Calculation_0892031754084362]' />
            </column>
            <column caption='Cause Description' datatype='string' name='[cause_description]' role='dimension' type='nominal' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Duration Hr' datatype='real' name='[duration_hr]' role='measure' type='quantitative' />
            <column caption='Equipment' datatype='string' name='[equipment]' role='dimension' type='nominal' />
            <column caption='Impact Type' datatype='string' name='[impact_type]' role='dimension' type='nominal' />
            <column caption='Is Planned' datatype='string' name='[is_planned]' role='dimension' type='nominal' />
            <column-instance column='[equipment]' derivation='None' name='[none:equipment:nk]' pivot='key' type='nominal' />
            <column-instance column='[operating_status]' derivation='None' name='[none:operating_status:nk]' pivot='key' type='nominal' />
            <column caption='Operating Status' datatype='string' name='[operating_status]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0892031753342982]' derivation='Sum' name='[sum:Calculation_0892031753342982:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0892031753658376]' derivation='Sum' name='[sum:Calculation_0892031753658376:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0892031754301451]' derivation='Sum' name='[sum:Calculation_0892031754301451:qk]' pivot='key' type='quantitative' />
            <column-instance column='[date]' derivation='Month-Trunc' name='[tmn:date:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1wo7vgu06mgblh1gax2tj1u49237].[Action (Cause Description)]'>
            <groupfilter function='level-members' level='[cause_description]' user:ui-action-filter='[Action4_9D886AEA81E442B1B25FF4533BC94135]' user:ui-enumeration='all' user:ui-marker='enumerate' />
