      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Cost Variance by Cost Center (USD)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_operations+' name='federated.1wo7vgu06mgblh1gax2tj1u49237' />
          </datasources>
          <datasource-dependencies datasource='federated.1wo7vgu06mgblh1gax2tj1u49237'>
            <column caption='Over/Under' datatype='string' name='[Calculation_0327158913200128]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1161136756518925] &gt;= 0 THEN &quot;Over Budget&quot; ELSE &quot;Under Budget&quot; END' />
            </column>
            <column caption='Cost Variance USD' datatype='real' name='[Calculation_1161136756518925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([actual_usd]) - SUM([budget_usd])' />
            </column>
            <column caption='Actual Usd' datatype='real' name='[actual_usd]' role='measure' type='quantitative' />
            <column caption='Budget Usd' datatype='real' name='[budget_usd]' role='measure' type='quantitative' />
