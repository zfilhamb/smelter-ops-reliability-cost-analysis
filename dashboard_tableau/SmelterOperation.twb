            <column-instance column='[operating_status]' derivation='None' name='[none:operating_status:nk]' pivot='key' type='nominal' />
            <column caption='Operating Status' datatype='string' name='[operating_status]' role='dimension' type='nominal' />
            <column-instance column='[date]' derivation='Month-Trunc' name='[tmn:date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0327158913200128]' derivation='User' name='[usr:Calculation_0327158913200128:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1161136756518925]' derivation='User' name='[usr:Calculation_1161136756518925:qk]' pivot='key' type='quantitative' />
            <column-instance column='[month_key]' derivation='Year' name='[yr:month_key:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1wo7vgu06mgblh1gax2tj1u49237].[Action (Cost Element,YEAR(Month Key))]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action3_E055DC4D337745A8A08ED563E259BC5A]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[cost_element]' />
              <groupfilter function='level-members' level='[yr:month_key:ok]' />
            </groupfilter>
          </filter>
          <computed-sort column='[federated.1wo7vgu06mgblh1gax2tj1u49237].[none:cost_center:nk]' direction='DESC' using='[federated.1wo7vgu06mgblh1gax2tj1u49237].[usr:Calculation_1161136756518925:qk]' />
