    <worksheet name='Pareto — Lost hours (equiv)'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Pareto — Lost hours (equiv) per equipment</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='daily_operations+' name='federated.1wo7vgu06mgblh1gax2tj1u49237' />
          </datasources>
          <datasource-dependencies datasource='federated.1wo7vgu06mgblh1gax2tj1u49237'>
            <column caption='Cumulative % Lost Hours' datatype='real' name='[Calculation_0542937481482247]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM([Calculation_0892031753478151])) / TOTAL(SUM([Calculation_0892031753478151]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Is Unplanned Impactful' datatype='integer' name='[Calculation_0892031753342982]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [is_planned] = &quot;N&quot; AND [impact_type] &lt;&gt; &quot;No Impact&quot; THEN 1 ELSE 0 END' />
            </column>
            <column caption='Lost Hours (equiv)' datatype='real' name='[Calculation_0892031753478151]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_0892031753342982] = 1&#13;&#10;THEN [duration_hr] * [throughput_loss_pct] / 100&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='Cause Description' datatype='string' name='[cause_description]' role='dimension' type='nominal' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
