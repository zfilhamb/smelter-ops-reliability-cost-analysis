            <column-instance column='[Calculation_0892031753478151]' derivation='Sum' name='[sum:Calculation_0892031753478151:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0892031753658376]' derivation='Sum' name='[sum:Calculation_0892031753658376:qk]' pivot='key' type='quantitative' />
            <column caption='Throughput Loss Pct' datatype='integer' name='[throughput_loss_pct]' role='measure' type='quantitative' />
            <column-instance column='[date]' derivation='Month-Trunc' name='[tmn:date:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1wo7vgu06mgblh1gax2tj1u49237].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1wo7vgu06mgblh1gax2tj1u49237].[sum:Calculation_0892031753342982:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1wo7vgu06mgblh1gax2tj1u49237].[sum:Calculation_0892031753478151:qk]&quot;' />
