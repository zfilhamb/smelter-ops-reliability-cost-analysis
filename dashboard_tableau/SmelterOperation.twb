      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1wo7vgu06mgblh1gax2tj1u49237].[avg:Calculation_0892031753658376:qk]&quot;' value='Avg. MTTR (hr)' />
          <alias key='&quot;[federated.1wo7vgu06mgblh1gax2tj1u49237].[avg:Calculation_0892031754301451:qk]&quot;' value='Avg. MTBF (hr) ' />
          <alias key='&quot;[federated.1wo7vgu06mgblh1gax2tj1u49237].[sum:Calculation_0892031753342982:qk]&quot;' value='Total Unplanned Events' />
          <alias key='&quot;[federated.1wo7vgu06mgblh1gax2tj1u49237].[sum:Calculation_0892031753478151:qk]&quot;' value='Total Lost Hours' />
        </aliases>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Calculation_0892031753478151])) / TOTAL(SUM([Calculation_0892031753478151]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='Over/Under' datatype='string' name='[Calculation_0327158913200128]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1161136756518925] &gt;= 0 THEN &quot;Over Budget&quot; ELSE &quot;Under Budget&quot; END' />
      </column>
      <column caption='Period Date' datatype='date' name='[Calculation_0327158916767745]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([period] + &quot;-01&quot;)' />
      </column>
      <column caption='overrun_pct ' datatype='real' name='[Calculation_0327158958923780]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100 * (duration_hr / planned_duration_hr - 1)' />
      </column>
      <column caption='Cumulative % Lost Hours' datatype='real' name='[Calculation_0542937481482247]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Calculation_0892031753478151])) / TOTAL(SUM([Calculation_0892031753478151]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Go to Cost Impact' datatype='string' name='[Calculation_0542937487360008]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;14,3% di atas rencana · klik untuk lihat dampak biaya →&quot;' />
      </column>
      <column caption='Event Date' datatype='date' name='[Calculation_0892031750381568]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([start_datetime])' />
      </column>
      <column caption='Is Unplanned Impactful' datatype='integer' name='[Calculation_0892031753342982]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_planned] = &quot;N&quot; AND [impact_type] &lt;&gt; &quot;No Impact&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Lost Hours (equiv)' datatype='real' name='[Calculation_0892031753478151]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_0892031753342982] = 1&#13;&#10;THEN [duration_hr] * [throughput_loss_pct] / 100&#13;&#10;ELSE 0 END' />
      </column>
      <column caption='MTTR (hr)  — LOD per equipment' datatype='real' name='[Calculation_0892031753658376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [equipment] : AVG(IF [Calculation_0892031753342982]=1 THEN [duration_hr] END) }' />
      </column>
      <column caption='DownHours' datatype='real' name='[Calculation_0892031753867273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [equipment] : SUM(IF [Calculation_0892031753342982]=1 THEN [duration_hr] END) }' />
      </column>
      <column caption='Failures' datatype='integer' name='[Calculation_0892031754084362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [equipment] : SUM([Calculation_0892031753342982]) }' />
      </column>
      <column caption='MTBF (hr)  — LOD per equipment' datatype='real' name='[Calculation_0892031754301451]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(duration_hr - [Calculation_0892031753867273]) / [Calculation_0892031754084362]' />
      </column>
      <column caption='Turnaround Overrun (hr)' datatype='real' name='[Calculation_0892031755493388]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [is_planned] = &quot;Y&quot; AND [duration_hr] &gt; [planned_duration_hr]&#13;&#10;THEN [duration_hr] - [planned_duration_hr] ELSE 0 END' />
      </column>
      <column caption='Cost Variance %' datatype='real' name='[Calculation_0892031766978573]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1161136756518925] / SUM([budget_usd])' />
      </column>
      <column caption='Missing Actual Rows' datatype='integer' name='[Calculation_0892031767080974]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [period_status] = &quot;Closed&quot; AND ISNULL([actual_usd]) THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Cost per t Cathode (Actual)' datatype='real' name='[Calculation_0892031767146511]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_usd]) / SUM([cathode_production_t])' />
      </column>
      <column caption='Stock Coverage (days)' datatype='real' name='[Calculation_0892031767212048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([closing_stock_reported_dmt]) / (SUM([concentrate_feed_dmt]) / COUNTD([date]))' />
      </column>
      <column caption='Needs Investigation Flag' datatype='integer' name='[Calculation_0892031767277585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [reconciliation_status] = &quot;Needs investigation&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='DQ - Missing SO2 on Running Day' datatype='integer' name='[Calculation_0892031767920658]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF ISNULL([so2_capture_pct]) AND [furnace_availability_pct] &gt; 50 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Feed Cu % (weighted)' datatype='real' name='[Calculation_1161136752087046]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([concentrate_feed_dmt] * [feed_cu_pct]) / SUM([concentrate_feed_dmt])' />
      </column>
      <column caption='Cu Recovery to Matte %' datatype='real' name='[Calculation_1161136754999303]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([matte_production_t] * [matte_grade_pct] / 100)&#13;&#10;  / SUM([concentrate_feed_dmt] * [feed_cu_pct] / 100)' />
      </column>
      <column caption='Feed Variance %' datatype='real' name='[Calculation_1161136755077128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([concentrate_feed_dmt]) - SUM([plan_concentrate_feed_dmt]))&#13;&#10;  / SUM([plan_concentrate_feed_dmt])' />
      </column>
      <column caption='Cathode Variance YTD ' datatype='real' name='[Calculation_1161136755167241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([cathode_production_t]) - SUM([plan_cathode_t]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cost Variance USD' datatype='real' name='[Calculation_1161136756518925]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([actual_usd]) - SUM([budget_usd])' />
      </column>
      <column caption='Budget Total' datatype='real' name='[Calculation_1402481249656832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM([budget_usd]) }' />
      </column>
      <column caption='Actual Total' datatype='real' name='[Calculation_1402481249726465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM([actual_usd]) }' />
      </column>
      <column caption='Cum Variance Incl' datatype='real' name='[Calculation_1402481250844676]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(([Calculation_1161136756518925]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cum Variance Excl' datatype='real' name='[Calculation_1402481250947077]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1402481250844676] - ([Calculation_1161136756518925])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
